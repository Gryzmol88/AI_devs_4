HUB_API_KEY=your_hub_api_key
HUB_SHELL_URL=https://hub.ag3nts.org/api/shell
HUB_VERIFY_URL=https://hub.ag3nts.org/verify

MAX_STEPS=40
REQUEST_TIMEOUT_SECONDS=60
RETRY_LIMIT=4
BACKOFF_BASE_SECONDS=1.0
OUTPUT_DIR_NAME=output
STOP_ON_BAN=true

SIDE_TASK_NAME=lesson2_side
SIDE_TASK_BINARY_PATH=/opt/firmware/cooler/cooler.bin
SIDE_TASK_ANSWER_KEY=confirmation
SIDE_TASK_AUTO_SUBMIT=true
SIDE_TASK_SUCCESS_REGEX=ECCS-[A-Za-z0-9]{40}
SIDE_TASK_PRE_COMMANDS=help,ls /,ls /home,ls /home/operator,ls /home/operator/notes,ls /opt,ls /opt/firmware,ls /opt/firmware/cooler,cat /home/operator/notes/pass.txt,cat /home/operator/.bash_history
CAPTURE_FILE_CONTENTS=true
CAPTURE_MAX_FILES=80
CAPTURE_MAX_CHARS=40000
DISCOVER_FULL_FS=true
DISCOVER_MAX_DIRS=500
