AIDEVS_API_KEY=your_api_key_here
AIDEVS_TASK=foodwarehouse
AIDEVS_VERIFY_URL=https://hub.ag3nts.org/verify
FOOD4CITIES_URL=https://hub.ag3nts.org/dane/food4cities.json

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OUTPUT_DIR=output
REQUEST_TIMEOUT_SECONDS=45

# Opcjonalne: gdy puste, aplikacja użyje auto-discovery na tabeli destinations.
CITY_DESTINATION_QUERY=SELECT city, destination FROM city_routes;

# Opcjonalne: gdy puste, aplikacja użyje auto-discovery na tabeli users.
CREATOR_QUERY=SELECT id, username, secret FROM users WHERE role='operator' LIMIT 1;

# Szablon payloadu dla signatureGenerator.
# Placeholdery wspierają m.in. {creator_id} oraz pola zwrócone przez CREATOR_QUERY.
SIGNATURE_TEMPLATE_JSON={"action":"generate","login":"{login}","birthday":"{birthday}","destination":"{destination}"}
