# ===== AIDEVS =====
AIDEVS_API_KEY=your-api-key
AIDEVS_TASK=windpower
AIDEVS_VERIFY_URL=https://hub.ag3nts.org/verify

# ===== OPENROUTER (opcjonalne) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=lesson2-windpower
OPENROUTER_SITE_URL=https://localhost

# ===== APP =====
APP_OUTPUT_DIR=output
APP_TIMEOUT_SECONDS=30
APP_POLL_INTERVAL_SECONDS=0.35
APP_POLL_TIMEOUT_SECONDS=36
APP_SERVICE_WINDOW_SECONDS=40
APP_USE_LLM_ASSIST=false
