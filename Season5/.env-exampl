# =========================
# Season5 / lesson2_barbakan
# Pelny, uporzadkowany .env
# =========================

# --- HUB / AIDEVS ---
AIDEVS_API_KEY=
AIDEVS_VERIFY_URL=https://hub.ag3nts.org/verify

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5


# --- OpenRouter TTS ---
# Glowny model TTS
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview

# Fallback przy 5xx (mozna dodac kolejne po przecinku)
OPENROUTER_TTS_FALLBACK_MODELS=x-ai/grok-voice-tts-1.0

# Voice i parametry mowienia
OPENROUTER_TTS_VOICE=Ara
OPENROUTER_TTS_SPEED=0.90

# Dla Gemini wymagany pcm
OPENROUTER_TTS_AUDIO_FORMAT=pcm

# Retry TTS
OPENROUTER_TTS_MAX_RETRIES=3
OPENROUTER_TTS_RETRY_BACKOFF_SECONDS=2.0

# --- OpenRouter STT ---
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_STT_LANGUAGE=pl
OPENROUTER_STT_AUDIO_FORMAT=mp3

# --- Piper local TTS (uzywane tylko gdy TTS_PROVIDER=piper) ---
TTS_PROVIDER=piper
PIPER_EXECUTABLE_PATH=M:\tools\piper\piper.exe
PIPER_MODEL_PATH=M:\tools\piper\models\pl_PL-mc_speech-medium.onnx
PIPER_SAMPLE_RATE=22050
FFMPEG_EXECUTABLE_PATH=

# --- App ---
REQUEST_TIMEOUT=60
DEBUG_SAVE_RAW=true
PIPER_LENGTH_SCALE=1.45
